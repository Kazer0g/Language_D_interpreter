// ===========================================================================
// Block 18 — Expression Precedence and Associativity
// Description : 18-expression-precedence.md
// Spec        : Language D.md §5 Expressions, §6 References
//
// Every runnable test of the block, in ID order. Each test is preceded by its
// ID and the value it must print.
//
// Negative tests are listed commented out at the end: each one aborts the
// program, so they cannot share a run. Uncomment one at a time.
//
// Where the operator blocks check what each operator does, this block checks
// how the five levels compose:
//   Expression (or and xor) < Relation (< <= > >= = /=) < Factor (+ -)
//   < Term (* /) < Unary (prefix + - not, and is) < Primary
//
// Assumes: a branch body is a scope (Language D.md §3.2).
// ===========================================================================

print "== Block 18 — Expression Precedence =="

// --------------------------------------------------------------------------
print "-- 0xx level against level --"
// --------------------------------------------------------------------------

// T-PREC-001  Term binds tighter than Factor   expect 14
print 2 + 3 * 4

// T-PREC-002  same, other order                expect 10
print 2 * 3 + 4

// T-PREC-003  Primary parentheses override     expect 20
print (2 + 3) * 4

// T-PREC-004  Factor binds tighter than Relation   expect true
print 1 + 2 < 4

// T-PREC-005  Term binds tighter than Relation     expect true
print 2 * 2 = 4

// T-PREC-006  Relation binds tighter than Expression   expect true
print 1 < 2 and 3 < 4

// T-PREC-007  three levels at once              expect true
print 1 + 1 = 2 and 2 + 2 = 4

// T-PREC-008  Unary binds tighter than Factor    expect 1
print -2 + 3

// T-PREC-009  Unary binds tighter than Term      expect -6
print -2 * 3

// T-PREC-010  not applies to a parenthesised Primary   expect false
print not (1 < 2)

// T-PREC-011  Term binds tighter than Factor     expect 1
print 6 / 3 - 1

// T-PREC-012  / then * then +                    expect 7
print 1 + 6 / 2 * 2

// --------------------------------------------------------------------------
print "-- 1xx associativity --"
// --------------------------------------------------------------------------

// T-PREC-101  - is left associative, not 9       expect 5
print 10 - 3 - 2

// T-PREC-102  / is left associative, not 20      expect 5
print 100 / 10 / 2

// T-PREC-103  * and / share a level, left to right   expect 3
print 2 * 6 / 4

// T-PREC-104  6/4 = 1 first — integer division makes the order visible   expect 2
print 6 / 4 * 2

// T-PREC-105  + and - share a level, left to right   expect 9
print 10 - 3 + 2

// T-PREC-106  chained +                          expect 6
print 1 + 2 + 3

// T-PREC-107  all logical operators share one level, left to right   expect true
print true and false or true

// T-PREC-108  (true or false) and false — one level, left to right (Q30)   expect false
print true or false and false

// T-PREC-109  parentheses defeat left associativity   expect 2
print 1 - (2 - 3)

// --------------------------------------------------------------------------
print "-- 2xx non-repeating relation --"
// --------------------------------------------------------------------------

// T-PREC-203  the inner relation is a Primary; boolean equality is allowed (Q5)   expect true
print (1 < 2) = true

// T-PREC-204  the derivable way to chain comparisons   expect true
print 1 < 2 and 2 < 3

// --------------------------------------------------------------------------
print "-- 3xx reference accessors bind tightest --"
// --------------------------------------------------------------------------

// T-PREC-301  indexing before +   expect 3
if true then
    var a := [1,2]
    print a[1] + a[2]
end

// T-PREC-302  the call before *   expect 6
if true then
    var f := func(x) => x
    print f(2) * 3
end

// T-PREC-303  dot access before + expect 3
if true then
    var t := {x := 2}
    print t.x + 1
end

// T-PREC-304  accessors chain left to right   expect 2
if true then
    var a := [[1,2]]
    print a[1][2]
end

// T-PREC-305  mixed accessor chain   expect 5
if true then
    var a := [ {x := 5} ]
    print a[1].x
end

// T-PREC-306  call then index       expect 2
if true then
    var f := func => [1,2]
    print f()[2]
end

// T-PREC-307  the index is a full Expression   expect 2
if true then
    var a := [1,2,3]
    print a[1 + 1]
end

// --------------------------------------------------------------------------
print "-- 4xx grammar corrections (Q3, Q4, Q20, Q40) --"
// --------------------------------------------------------------------------

// T-PREC-402  Primary derives Reference (Q4)   expect -5
if true then
    var a := 5
    print -a
end

// T-PREC-403  is accepts any Primary (Q20)   expect true
print 1 is int

// T-PREC-404  is binds tighter than and: (a is int) and true   expect true
if true then
    var a := 1
    print a is int and true
end

// T-PREC-406  deep parenthesis nesting   expect 1
print ((((1))))

// T-PREC-409  parenthesise the arithmetic to test its result   expect true
if true then
    var a := 1
    print (a + 1) is int
end

// T-PREC-410  a prefix applies to the whole Unary after it: not (a is int)   expect false
if true then
    var a := 1
    print not a is int
end

// T-PREC-411  stacked prefixes, then +   expect 4
print - -1 + 3

// T-PREC-412  a prefix on each Term operand   expect 6
print -2 * -3

// T-PREC-415  binary + followed by unary +   expect 2
print 1 + +1

// T-PREC-416  binary - then two stacked unary minuses   expect 0
print 1 - - - 1

print "== end of block 18 =="

