// ===========================================================================
// Custom 05 — Bubble sort
// Exercises: nested for loops, array element assignment, three-way swap,
//            early termination with a flag
//
// The language has no way to ask an array for its size (T-ARR-903), so the
// length is counted with an aggregate loop first. That idiom is reused by
// every array program in this directory.
// ===========================================================================

print "== Bubble sort =="

var a := [5, 2, 9, 1, 5, 6, 3]

// --- count the elements ---

var n := 0
for v in a loop
    n := n + 1
end
print "length is", n              // expect 7

// --- sort in place ---

for i in 1..n - 1 loop
    for j in 1..n - i loop
        if a[j] > a[j + 1] then
            var tmp := a[j]
            a[j] := a[j + 1]
            a[j + 1] := tmp
        end
    end
end

for v in a loop
    print v
end
// expect 1 2 3 5 5 6 9

// --- the same with early termination when a pass makes no swap ---

var b := [4, 1, 3, 9, 7]
var m := 0
for v in b loop
    m := m + 1
end

var pass := 1
var sorted := false
while not (sorted) loop
    sorted := true
    for j in 1..m - pass loop
        if b[j] > b[j + 1] then
            var tmp := b[j]
            b[j] := b[j + 1]
            b[j + 1] := tmp
            sorted := false
        end
    end
    pass := pass + 1
    if pass >= m => sorted := true
end

for v in b loop
    print v
end
// expect 1 3 4 7 9

// --- sorting is stable enough to sort an already sorted array ---

var c := [1, 2, 3]
var k := 0
for v in c loop
    k := k + 1
end
for i in 1..k - 1 loop
    for j in 1..k - i loop
        if c[j] > c[j + 1] then
            var tmp := c[j]
            c[j] := c[j + 1]
            c[j + 1] := tmp
        end
    end
end
for v in c loop
    print v
end
// expect 1 2 3

print "== end =="
