// ===========================================================================
// Custom 14 — Collatz sequences, fast exponentiation, integer square root
// Exercises: while loops with a changing condition, parity without modulo,
//            halving by integer division, accumulating a maximum
// ===========================================================================

print "== Collatz, the sequence for 6 =="

var n := 6
print n
while n /= 1 loop
    if 2 * (n / 2) = n then
        n := n / 2
    else
        n := 3 * n + 1
    end
    print n
end
// expect 6 3 10 5 16 8 4 2 1

print "== Collatz, step counts =="

// --- how many steps each start needs to reach 1 ---

for start in 1..10 loop
    var v := start
    var steps := 0
    while v /= 1 loop
        if 2 * (v / 2) = v then v := v / 2 else v := 3 * v + 1 end
        steps := steps + 1
    end
    print start, steps
end
// expect
//  1 0
//  2 1
//  3 7
//  4 2
//  5 5
//  6 8
//  7 16
//  8 3
//  9 19
// 10 6

// --- the longest chain and the highest value reached, for starts 1..27 ---

var bestStart := 1, bestSteps := 0, highest := 1
for start in 1..27 loop
    var v := start
    var steps := 0
    while v /= 1 loop
        if v > highest => highest := v
        if 2 * (v / 2) = v then v := v / 2 else v := 3 * v + 1 end
        steps := steps + 1
    end
    if steps > bestSteps then
        bestSteps := steps
        bestStart := start
    end
end
print "longest chain starts at", bestStart           // expect 27
print "and takes", bestSteps, "steps"                // expect 111
print "highest value seen", highest                  // expect 9232

print "== Fast exponentiation =="

// --- 3^10 by repeated squaring ---

var base := 3, e := 10
var result := 1, b := base
while e > 0 loop
    if 2 * (e / 2) /= e => result := result * b
    b := b * b
    e := e / 2
end
print "3^10 =", result            // expect 59049

// --- a table of 2^k ---

for k in 0..16 loop
    var acc := 1
    var i := 1
    while i <= k loop
        acc := acc * 2
        i := i + 1
    end
    print k, acc
end
// expect 0 1, 1 2, 2 4, ... 16 65536

print "== Integer square root =="

// --- the largest r with r * r <= v, found by scanning ---

var values := [1, 2, 9, 15, 16, 17, 100, 101, 999, 1000]
for v in values loop
    var r := 0
    while (r + 1) * (r + 1) <= v loop
        r := r + 1
    end
    print v, r
end
// expect 1 1, 2 1, 9 3, 15 3, 16 4, 17 4, 100 10, 101 10, 999 31, 1000 31

print "== end =="
