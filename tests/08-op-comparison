// T-CMP-105  runtime error: no array equality
// print [1] = [1]

// T-CMP-106  runtime error
// print [1] < [2]

// T-CMP-107  runtime error: no tuple equality
// print {a := 1} = {a := 1}

// T-CMP-108  runtime error: the only operation on a function is a call
// var f := func => 0
// print f = f

// T-CMP-109  runtime error: none cannot act as an operand
// var n
// print n = 1

// T-CMP-110  runtime error: even none to none
// var n, m
// print n = m

// T-CMP-111  runtime error: <= is ordering, not extended
// print "a" <= "a"

// T-CMP-112  runtime error
// print true >= false

