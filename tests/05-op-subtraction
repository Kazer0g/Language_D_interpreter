print "== Block 05 — Subtraction =="

// --------------------------------------------------------------------------
print "-- 0xx supported types --"
// --------------------------------------------------------------------------

// T-SUB-001  Integer - Integer -> Integer   expect 2
print 5 - 3

// T-SUB-002  Integer - Real -> Real         expect 1.5
print 5 - 3.5

// T-SUB-003  Real - Integer -> Real         expect 2.5
print 5.5 - 3

// T-SUB-004  Real - Real -> Real            expect 2.0
print 5.5 - 3.5

// T-SUB-005  negative result                expect -2
print 3 - 5

// T-SUB-006  zero result                    expect 0
print 5 - 5

// T-SUB-007  operand types are checked dynamically   expect 2
if true then
    var a := 5, b := 3
    print a - b
end

// T-SUB-008  binary minus then unary minus  expect 8
print 5 - -3

// --------------------------------------------------------------------------
print "-- 2xx semantics --"
// --------------------------------------------------------------------------

// T-SUB-201  left associative, not 10 - (3 - 2) = 9   expect 5
print 10 - 3 - 2

// T-SUB-202  + and - share a level, left to right     expect 9
print 10 - 3 + 2

// T-SUB-203  parentheses override                     expect 9
print 10 - (3 - 2)

// T-SUB-204  * binds tighter                          expect 4
print 10 - 2 * 3

// T-SUB-205  the result stays Real once widened       expect 1.5
print 5 - 2.5 - 1

// T-SUB-206  chained                                  expect -8
print 1 - 2 - 3 - 4

// --------------------------------------------------------------------------
print "-- 9xx decided --"
// --------------------------------------------------------------------------

// T-SUB-902  IEEE double arithmetic, shortest round-trip rendering (Q28)
//            expect 0.19999999999999998
print 0.3 - 0.1

// T-SUB-903  a whole-valued real still prints with a dot   expect 2.0
print 2.5 - 0.5

print "== end of block 05 =="

