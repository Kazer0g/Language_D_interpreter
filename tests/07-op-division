// ===========================================================================
// Block 07 — Division (/)
// Description : 07-op-division.md
// Spec        : Language D.md §8.4 Division
//
// Every runnable test of the block, in ID order. Each test is preceded by its
// ID and the value it must print.
//
// Negative tests are listed commented out at the end: each one aborts the
// program, so they cannot share a run. Uncomment one at a time.
//
// "Round down" is floor (Q7): -7 / 2 is -4. Division by zero is a runtime
// error in every form (Q6); those tests are in the negative section.
//
// Relies on: a branch body is a scope (Language D.md §3.2).
// ===========================================================================

print "== Block 07 — Division =="

// --------------------------------------------------------------------------
print "-- 0xx supported types --"
// --------------------------------------------------------------------------

// T-DIV-001  Integer / Integer -> Integer   expect 3
print 6 / 2

// T-DIV-002  Integer / Real -> Real         expect 3.5
print 7 / 2.0

// T-DIV-003  Real / Integer -> Real         expect 3.5
print 7.0 / 2

// T-DIV-004  Real / Real -> Real            expect 3.5
print 7.0 / 2.0

// T-DIV-005  operand types are checked dynamically   expect 3
if true then
    var a := 6, b := 2
    print a / b
end

// T-DIV-006  identity                       expect 5
print 5 / 1

// --------------------------------------------------------------------------
print "-- 2xx integer division rounds down --"
// --------------------------------------------------------------------------

// T-DIV-201  rounded down, not 3.5          expect 3
print 7 / 2

// T-DIV-202  expect 0
print 1 / 2

// T-DIV-203  expect 0
print 9 / 10

// T-DIV-204  one Real operand suppresses the rounding   expect 3.5
print 7 / 2.0

// T-DIV-205  floor toward negative infinity (Q7)   expect -4
print -7 / 2

// T-DIV-206  floor (Q7)                     expect -4
print 7 / -2

// T-DIV-207  expect 3
print -7 / -2

// T-DIV-208  exact division is unaffected   expect 2
print 6 / 3

// T-DIV-209  floor, not 0                   expect -1
print -1 / 2

// T-DIV-210  exact negative division        expect -2
print -6 / 3

// --------------------------------------------------------------------------
print "-- 3xx precedence and associativity --"
// --------------------------------------------------------------------------

// T-DIV-301  left associative, not 100 / (10 / 2) = 20   expect 5
print 100 / 10 / 2

// T-DIV-302  same level as *, left to right              expect 3
print 2 * 6 / 4

// T-DIV-303  6/4 = 1 first, then * 2                     expect 2
print 6 / 4 * 2

// T-DIV-304  / binds tighter than +                      expect 4
print 1 + 6 / 2

// T-DIV-305  parentheses override                        expect 3
print (1 + 6) / 2

print "== end of block 07 =="

