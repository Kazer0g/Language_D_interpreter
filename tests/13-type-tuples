// var t := {1 := 5}

// T-TUP-205  runtime error: this would modify the structure (Q11)
// var t := {a := 1}
// t.b := 5

// T-TUP-207  runtime error: duplicate names after concatenation (Q10)
// var t := {a := 1}
// print t + {a := 2}

// T-TUP-209  runtime error: position 2 does not exist, no growth by assignment
// var t := {a := 1}
// t.2 := 5
