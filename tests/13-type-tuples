// var t := {a := 1, a := 2}

// T-TUP-102  runtime error: no such element name
// var t := {a := 1}
// print t.b

// T-TUP-103  runtime error: position beyond the fixed size
// var t := {a := 1}
// print t.2

// T-TUP-104  runtime error: numbering starts with one
// var t := {a := 1}
// print t.0

// T-TUP-105  runtime error: `. i` reads i as an element NAME, not a variable
// var t := {a := 1}
// var i := 1
// print t.i

// T-TUP-106  syntax error: the position must be an IntegerLiteral
// var t := {a := 1}
// print t.(1)

// T-TUP-107  syntax error
// var t := {a := 1}
// print t.1.5

// T-TUP-108  syntax error: the grammar requires at least one TupleElement
// var t := {}

// T-TUP-109  syntax error: trailing comma
// var t := {a := 1,}

// T-TUP-110  runtime error: a tuple is accessed with . not [ ]
