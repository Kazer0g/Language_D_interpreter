// ===========================================================================
// Block 06 — Multiplication (*)
// Description : 06-op-multiplication.md
// Spec        : Language D.md §8.3 Multiplication
//
// Every runnable test of the block, in ID order. Each test is preceded by its
// ID and the value it must print.
//
// Negative tests are listed commented out at the end: each one aborts the
// program, so they cannot share a run. Uncomment one at a time.
//
// Assumes: a branch body is a scope (Language D.md §3.2).
// ===========================================================================

print "== Block 06 — Multiplication =="

// --------------------------------------------------------------------------
print "-- 0xx supported types --"
// --------------------------------------------------------------------------

// T-MUL-001  Integer * Integer -> Integer   expect 6
print 2 * 3

// T-MUL-002  Integer * Real -> Real         expect 3.0
print 2 * 1.5

// T-MUL-003  Real * Integer -> Real         expect 3.0
print 1.5 * 2

// T-MUL-004  Real * Real -> Real            expect 3.0
print 1.5 * 2.0

// T-MUL-005  zero                           expect 0
print 5 * 0

// T-MUL-006  negative                       expect -6
print -2 * 3

// T-MUL-007  two negatives                  expect 6
print -2 * -3

// T-MUL-008  operand types are checked dynamically   expect 6
if true then
    var a := 2, b := 3
    print a * b
end

// T-MUL-009  identity                       expect 7
print 7 * 1

// --------------------------------------------------------------------------
print "-- 2xx semantics --"
// --------------------------------------------------------------------------

// T-MUL-201  left associative, chained          expect 24
print 2 * 3 * 4

// T-MUL-202  * binds tighter than +             expect 14
print 2 + 3 * 4

// T-MUL-203  parentheses override               expect 20
print (2 + 3) * 4

// T-MUL-204  * and / share a level, left to right: 6 / 4   expect 1
print 2 * 3 / 4

// T-MUL-205  the result stays Real once widened  expect 6.0
print 2 * 1.5 * 2

// T-MUL-206  unary binds tighter than *          expect -5
print -2 * 3 + 1

// --------------------------------------------------------------------------
print "-- 9xx decided --"
// --------------------------------------------------------------------------

// T-MUL-902  IEEE double arithmetic, shortest round-trip rendering (Q28)
//            expect 0.30000000000000004
print 0.1 * 3

// T-MUL-903  the largest product that fits in 64 bits is not an error (Q27)
//            expect 9223372030926249001
print 3037000499 * 3037000499

print "== end of block 06 =="

